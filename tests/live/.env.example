# Settings for the live tests in tests/live. Copy this file to tests/live/.env
# and fill in the values. The .env file is ignored by git.

# Contabo API credentials. The Customer Control Panel shows them under
# Account > Security ("API"). The values in ~/.cntb.yaml work too.
CNTB_OAUTH2_CLIENT_ID=
CNTB_OAUTH2_CLIENT_SECRET=
CNTB_OAUTH2_USER=
CNTB_OAUTH2_PASS=

# Workload identity test (tests/live/workload-identity).
# The public IPv4 address of a Contabo instance that runs Talos in maintenance mode.
TF_VAR_node_ip=
# The id of an existing object storage. The test creates its own bucket in it.
TF_VAR_object_storage_id=
# The Image Factory schematic of the Talos image on the instance.
TF_VAR_talos_schematic_id=

# Azure: the test uses your Azure CLI login (az login). No variable is needed.

# Live tests of the examples (tests/live/examples).
# A DNS zone on the Contabo name servers. The tests create A records in it.
EXAMPLES_DNS_ZONE=

# Root module test (tests/live/cluster).
# The Contabo instance that the test erases and adopts. Choose an instance
# that holds nothing you need.
TF_VAR_instance_id=
# An existing private network that already contains the instance. The test
# never changes the network.
TF_VAR_private_network_id=

# Tailscale test (tests/live/ha with HA_TAILSCALE=1).
# A Tailscale API access token of an admin of the tailnet. The test replaces
# the tailnet policy, turns on HTTPS and creates OAuth clients.
TAILSCALE_ACCESS_TOKEN=
# The MagicDNS domain of the tailnet, for example tail1234.ts.net.
TAILSCALE_TAILNET_DOMAIN=
